rules_version='2';service cloud.firestore{match /databases/{db}/documents{
function admin(){return request.auth!=null&&request.auth.token.admin==true}
function approved(){return request.auth!=null&&get(/databases/$(db)/documents/users/$(request.auth.uid)).data.approvalStatus=='approved'}
match /users/{u}{allow read:if request.auth.uid==u||admin();allow write:if false}
match /services/{s}{allow read:if resource.data.active==true||admin();allow write:if admin()}
match /workers/{w}{allow read:if approved()&&resource.data.active==true||admin();allow write:if admin()}
match /vehicles/{v}{allow read:if admin()||resource.data.ownerUid==request.auth.uid;allow create:if approved()&&request.resource.data.ownerUid==request.auth.uid;allow update,delete:if admin()||resource.data.ownerUid==request.auth.uid}
match /appointments/{a}{allow read:if admin()||resource.data.customerUid==request.auth.uid;allow write:if false}
match /payments/{p}{allow read:if admin()||resource.data.customerUid==request.auth.uid;allow write:if false}
match /receipts/{r}{allow read:if admin()||resource.data.customerUid==request.auth.uid;allow write:if false}
match /notifications/{n}{allow read:if resource.data.recipientUid==request.auth.uid;allow update:if resource.data.recipientUid==request.auth.uid}
match /shopSettings/{s}{allow read:if true;allow write:if admin()}
match /{o=**}{allow read,write:if false}}}
